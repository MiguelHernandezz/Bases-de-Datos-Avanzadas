43 0 obj
<</Type/Annot/Subtype/Widget/AP<</N 465 0 R>>/DA(0 g /Helv 10 Tf)/F 4/FT/Tx/Ff 33558528/MK<</BG[.988235 .956863 .521576]>>/P 19 0 R/Rect[85.0417 549.14 541.456 666.846]/T(Text3)/V(SELECT\n    g.nombre                         AS grupo,\n    COUNT\(DISTINCT ca.id_cancion\)    AS total_canciones,\n    COUNT\(DISTINCT co.id_concierto\)  AS total_conciertos\nFROM grupos g\nLEFT JOIN canciones  ca ON ca.id_grupo = g.id_grupo\nLEFT JOIN conciertos co ON co.id_grupo = g.id_grupo\nGROUP BY g.id_grupo, g.nombre\nORDER BY g.nombre;)/BS<</S/S/W 1>>>>
endobj

